<Project>

  <!--
    SINGLE SOURCE OF TRUTH FOR THE APPLICATION VERSION
    Semantic versioning is mandatory in this repository (see AGENTS.md, section 5):

      MAJOR . MINOR . PATCH

      MAJOR = breaking or architectural changes (schema break, removed feature,
              incompatible settings layout).
      MINOR = moderate features / non-breaking behaviour changes (a new settings
              toggle, a new UI mode, a new dialog, a new integration).
      PATCH = minor improvements, small fixes, polish, docs corrections.

    Bump the version in exactly ONE place: the Version property below.
    - Never hard-code a version in a .csproj, PowerShell script, or markdown doc.
    - The app, the installer, the tests, and the release script all read this.
    - tools/build_releases.ps1 names release artifacts from this value.
    - tools/bump-version.ps1 -Part minor (or patch/major) updates this file and
      the documentation release matrix together.

    docs/CHANGELOG.md records what each version changed and why.
  -->
  <PropertyGroup>
    <Version>3.1.1</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ProductVersion>$(Version)</ProductVersion>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>OpenCode</Company>
    <Product>ClipboardApp</Product>
  </PropertyGroup>

</Project>
