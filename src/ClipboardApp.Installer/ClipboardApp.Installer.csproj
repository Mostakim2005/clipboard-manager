<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ClipboardApp-Setup</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Version, AssemblyVersion, FileVersion come from /Directory.Build.props. -->
    <Product>ClipboardApp Setup</Product>
    <Company>OpenCode</Company>
    <Description>ClipboardApp Windows Setup Engine</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      payload.bin is GENERATED by tools/pack.ps1 from the freshly published
      portable binary and is intentionally NOT committed (see .gitignore).
      Before the setup project is published, tools/build_releases.ps1 always
      runs pack.ps1 so the embedded payload is never stale.

      Building the installer solution without a payload therefore fails loudly
      rather than silently embedding an old binary.
    -->
    <EmbeddedResource Include="Resources\payload.bin" Condition="Exists('Resources\payload.bin')">
      <LogicalName>payload.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Debug builds stay payload-free so day-to-day work on the app is never blocked.
    A Release build is the packaging path: it must never embed a stale payload.
  -->
  <Target Name="RequireInstallerPayload" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('Resources\payload.bin')"
           Text="src/ClipboardApp.Installer/Resources/payload.bin is missing. Run '.\tools\build_releases.ps1 -BuildInstaller', which publishes the portable app and regenerates the payload automatically." />
  </Target>
</Project>
